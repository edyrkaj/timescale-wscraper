# Copy to .env and adjust as needed:
#   cp .env.example .env

# TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=scrapers_db
POSTGRES_PORT=5432

# App
DATABASE_URL=postgres://postgres:password@timescaledb:5432/scrapers_db
BIND_ADDR=0.0.0.0:8080
APP_PORT=8080
RUST_LOG=info

# Chromium (optional; Dockerfile sets /usr/bin/chromium)
# CHROME_PATH=/usr/bin/chromium

# Local cargo run (host, not Docker network):
# DATABASE_URL=postgres://postgres:password@localhost:5432/scrapers_db
