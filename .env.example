# Copy to .env and adjust as needed:
#   cp .env.example .env

# TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=scrapers_db
POSTGRES_PORT=5432

# App
DATABASE_URL=postgres://postgres:password@timescaledb:5432/scrapers_db
BIND_ADDR=0.0.0.0:8080
APP_PORT=8080
RUST_LOG=info

# Playwright DOM worker (Docker Compose service)
PLAYWRIGHT_URL=http://playwright:3001
# HEADLESS=0
# PLAYWRIGHT_BROWSER=chromium
# PLAYWRIGHT_PORT=3001

# OpenAI-compatible LLM (required when AI Scraper is enabled)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Ollama example:
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2

# Local cargo run (host, not Docker network):
# DATABASE_URL=postgres://postgres:password@localhost:5432/scrapers_db
# PLAYWRIGHT_URL=http://localhost:3001
