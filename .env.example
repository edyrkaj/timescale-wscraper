# Copy to .env and adjust as needed:
#   cp .env.example .env

# TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=scrapers_db
POSTGRES_PORT=5432

# App (API)
DATABASE_URL=postgres://postgres:password@timescaledb:5432/scrapers_db
BIND_ADDR=0.0.0.0:8080
APP_PORT=8080
RUST_LOG=info

# UI (nginx static server)
UI_PORT=3000

# Playwright DOM worker (Docker Compose service)
PLAYWRIGHT_URL=http://playwright:3001
# HEADLESS=0
# PLAYWRIGHT_BROWSER=chromium
# PLAYWRIGHT_PORT=3001

# Anthropic-compatible LLM (AI provider: anthropic)
ANTHROPIC_BASE_URL=https://api.meta.ai
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=muse-spark-1.3-contributor
# Optional aliases used by some tools; scraper reads ANTHROPIC_MODEL (or ANTHROPIC_DEFAULT_SONNET_MODEL)
# ANTHROPIC_DEFAULT_SONNET_MODEL=muse-spark-1.3-contributor
# Token can also be provided as MODEL_API_KEY if ANTHROPIC_AUTH_TOKEN is empty
# MODEL_API_KEY=

# Google Gemini (AI provider: gemini)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional comma-separated fallbacks on 503 / high demand (defaults include Gemini 3 + 2.5 family)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-pro-preview,gemini-3.1-flash-live-preview,gemini-3.1-flash-lite-preview,gemini-3.8-flash-live,gemini-3.8-flash-tts,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite

# Local cargo run (host, not Docker network):
# DATABASE_URL=postgres://postgres:password@localhost:5432/scrapers_db
# PLAYWRIGHT_URL=http://localhost:3001
